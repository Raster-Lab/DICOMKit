<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox ENABLED (2026-08-03). It had been disabled so the CLI Workshop
	     could spawn the real `dicom-*` binaries for the side-by-side terminal
	     compare; that feature's UI is gone, so the sandbox is back on.
	     NOTE: CLIToolTerminalCompare is still in the source tree but CANNOT launch
	     a subprocess under the sandbox — re-enabling it for local testing means
	     temporarily flipping this back to <false/>. Do not ship it as <false/>. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<!-- NOTE: the absolute-path temporary exceptions for one developer's
	     ~/Desktop/DICOM_Input and ~/Desktop/DICOM_Output were removed on
	     2026-08-03. They weakened the sandbox and the App Store rejects them.
	     Files are reached the sandbox-approved way instead: the user picks them
	     (files.user-selected.read-write) and access persists via app-scoped
	     bookmarks. Do not reintroduce absolute-path exceptions. -->

</dict>
</plist>
